# Copy this file to .env at the repo root.

# Vercel AI Gateway key (Vercel dashboard -> AI Gateway -> API Keys).
# Used for Jev (typesafe-ai/jev) and, later, the companion LLM.
AI_GATEWAY_API_KEY=

# Or a direct TypeSafe key (console.typesafe.ai). Takes priority if set.
# TYPESAFE_API_KEY=

# Optional: override the Jev model name
# FIRSTREAD_MODEL=typesafe-ai/jev

# OpenAI key: the LLM baselines in the evals (pnpm eval:bhh --client luna|sol), and the demo
# companion in local development only. The deployed demo uses each visitor's own key.
# OPENAI_API_KEY=

# The web app (apps/web) reads this same root .env.
# Companion chatbot in the demo: OpenAI directly with OPENAI_API_KEY above.
# COMPANION_MODEL=gpt-6-sol
# COMPANION_REASONING_EFFORT=low
# NOTES_MODEL=gpt-6-luna
