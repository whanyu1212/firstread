# Copy this file to .env at the repo root.

# Vercel AI Gateway key (Vercel dashboard -> AI Gateway -> API Keys).
# Used for Jev (typesafe-ai/jev) and, later, the companion LLM.
AI_GATEWAY_API_KEY=

# Or a direct TypeSafe key (console.typesafe.ai). Takes priority if set.
# TYPESAFE_API_KEY=

# Optional: override the Jev model name
# FIRSTREAD_MODEL=typesafe-ai/jev
