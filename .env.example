# Copy this file to .env and set ONE of these keys.

# Vercel AI Gateway (Vercel dashboard -> AI Gateway -> API Keys).
# Requests go to https://ai-gateway.vercel.sh/typesafe with model typesafe-ai/jev.
AI_GATEWAY_API_KEY=

# Or a direct TypeSafe key (console.typesafe.ai). Takes priority if set.
# TYPESAFE_API_KEY=

# Optional: override the model name
# FIRSTREAD_MODEL=typesafe-ai/jev
