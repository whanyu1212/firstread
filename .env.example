# Copy this file to .env at the repo root.

# Vercel AI Gateway key (Vercel dashboard -> AI Gateway -> API Keys).
# Used for Jev (typesafe-ai/jev).
AI_GATEWAY_API_KEY=

# Or a direct TypeSafe key (console.typesafe.ai). Takes priority if set.
# TYPESAFE_API_KEY=

# Optional: override the Jev model name
# FIRSTREAD_MODEL=typesafe-ai/jev

# OpenAI key: the LLM baselines in the evals (pnpm eval:bhh --client luna|sol), and the demo's
# companion. Visitors can also add their own key in the demo.
# OPENAI_API_KEY=

# Optional locally: Upstash Redis (Vercel Marketplace) for the demo's sessions and limits.
# Without it, sessions live in memory, and a production server won't run typed messages on
# OPENAI_API_KEY.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# The web app (apps/web) reads this same root .env.
# Companion chatbot in the demo: OpenAI directly with OPENAI_API_KEY above.
# COMPANION_MODEL=gpt-6-sol
# COMPANION_REASONING_EFFORT=low
# NOTES_MODEL=gpt-6-luna
